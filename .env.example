# Copy to .env, fill in, then run scripts/setup_github.sh to load these as GitHub secrets.
# Never commit .env.

# Claude API key from https://console.anthropic.com (separate from a claude.ai subscription)
ANTHROPIC_API_KEY=
# Optional model override (default: claude-sonnet-5-5)
CLAUDE_MODEL=

# Instagram (see README, "Instagram setup")
IG_USER_ID=
IG_ACCESS_TOKEN=

# YouTube Shorts (optional, see README)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
